# Corevia Talk production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.

# Image published by the public image pipeline. Use `:main` for pre-release testing. Pin `:sha-<7>` or a semver release tag for production.
COREVIA_TALK_IMAGE=ghcr.io/block/buzz:main

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
COREVIA_TALK_DOMAIN=corevia-talk.example.com
RELAY_URL=wss://corevia-talk.example.com
COREVIA_TALK_MEDIA_BASE_URL=https://corevia-talk.example.com/media
COREVIA_TALK_MEDIA_SERVER_DOMAIN=corevia-talk.example.com
COREVIA_TALK_CORS_ORIGINS=https://corevia-talk.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
COREVIA_TALK_REQUIRE_AUTH_TOKEN=true
COREVIA_TALK_REQUIRE_RELAY_MEMBERSHIP=true
COREVIA_TALK_ALLOW_NIP_OA_AUTH=true
COREVIA_TALK_AUTO_MIGRATE=true
COREVIA_TALK_GIT_CONFORMANCE_PROBE=true
# Push stays disabled unless explicitly enabled. Keep the delivery endpoint
# explicit so enabling it never depends on an in-code deployment fallback.
COREVIA_TALK_PUSH_ENABLED=false
COREVIA_TALK_PUSH_GATEWAY_DELIVERY_URL=https://push.buzz.xyz/v1/deliveries/apns
RUST_LOG=corevia_talk_relay=info,corevia_talk_db=info,corevia_talk_auth=info,corevia_talk_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
COREVIA_TALK_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
COREVIA_TALK_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=corevia_talk
POSTGRES_USER=corevia_talk
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
COREVIA_TALK_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
COREVIA_TALK_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
COREVIA_TALK_S3_BUCKET=corevia-talk-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
COREVIA_TALK_S3_ADDRESSING_STYLE=path

# Optional private moderation dashboard. Set COREVIA_TALK_ADMIN_HOST plus COREVIA_TALK_ADMIN_AUTH:
#   COREVIA_TALK_ADMIN_AUTH=nip98 (default) — NIP-98 HTTP Auth via Nostr pubkey-based auth.
#     Authorized principals resolve from RELAY_OPERATOR_PUBKEYS (config Operators),
#     RELAY_OWNER_PUBKEY (implicit Operator fallback when operator list is empty),
#     and the relay_operators table (DB-managed Operator/Moderator roster).
#     Dashboard requires a NIP-07 browser extension (nos2x or Alby).
#   COREVIA_TALK_ADMIN_AUTH=disabled — read-only, no auth. Anyone who can reach the relay
#     can read every community's reports, feedback and attachments, bans and
#     timeouts, community directory, member profiles and any stored message by
#     ID; writes and staffing are refused. Only people allowed to see all of that
#     may reach it. The admin API is on the relay's main port and its hostname
#     check uses the caller's Host header, so the published relay port itself must
#     be private; a private admin hostname is not enough. Relay logs a WARN on boot.
# Token authentication was removed: COREVIA_TALK_ADMIN_TOKEN is ignored with a startup
# warning — remove it from the environment.
# Any unrecognised COREVIA_TALK_ADMIN_AUTH value aborts startup.
# When COREVIA_TALK_ADMIN_HOST is set, the relay advertises the admin origin in its NIP-11
# document (`admin_api` field) so clients auto-discover the console without manual entry.
# Setting RELAY_OPERATOR_PUBKEYS for the console does NOT require RELAY_OPERATOR_API_ORIGIN;
# that origin is only for community provisioning (POST /operator/communities), which fails
# closed at request time until it is set (the relay boots with a WARN in the meantime).
# COREVIA_TALK_ADMIN_HOST=admin.corevia-talk.example.com
# COREVIA_TALK_ADMIN_AUTH=nip98
# RELAY_OPERATOR_PUBKEYS=<64-char hex pubkey>[,<64-char hex pubkey>...]
# RELAY_OPERATOR_API_ORIGIN=https://admin.corevia-talk.example.com

# Optional host ports. Base compose publishes the relay directly on COREVIA_TALK_HTTP_PORT.
COREVIA_TALK_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
